<!DOCTYPE html>
<html xmlns="https://xineartsolutions.com">
<%- include('../partials/header.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    
    <div class="detail-ui content">
        <h2><%= title %></h2>
        
        <div class="delete-warning">
            <div class="warning-icon">⚠️</div>
            <h3>Are you sure you want to delete this question?</h3>
            <p>This action cannot be undone. All associated options will also be deleted.</p>
        </div>

        <div class="detail-section">
            <div class="detail-row">
                <span class="detail-label">ID:</span>
                <span class="detail-value"><%= question.Id %></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Exam:</span>
                <span class="detail-value"><%= examName || 'N/A' %></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Question:</span>
                <span class="detail-value"><%= question.Text %></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Type:</span>
                <span class="detail-value">
                    <% if (question.AnswerType === 0) { %>
                        Single Choice
                    <% } else if (question.AnswerType === 1) { %>
                        Multiple Choice
                    <% } else if (question.AnswerType === 2) { %>
                        Essay
                    <% } %>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Options:</span>
                <span class="detail-value"><%= options ? options.length : 0 %> options</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Date Created:</span>
                <span class="detail-value"><%= question.DateCreated ? new Date(question.DateCreated).toLocaleString() : 'N/A' %></span>
            </div>
        </div>

        <div class="form-buttons">
            <form action="/questions/delete/<%= question.Id %>" method="POST" style="display: inline-block;">
                <button type="submit" class="btn btn-danger">Yes, Delete Question</button>
            </form>
            <a href="/questions?examId=<%= question.ExamId || '' %>" class="cancel-button">Cancel</a>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</body>
</html>