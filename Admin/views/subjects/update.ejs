<!DOCTYPE html>
<html xmlns="https://xineartsolutions.com">
<%- include('../partials/header.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    
    <div class="detail-ui content">
        <h2><%= title %></h2>
        
        <% if (error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>

        <form action="/subjects/update/<%= subject.Id %>" method="POST">
            <div class="form-group">
                <label for="Id">ID:</label>
                <p><%= subject.Id %></p>
            </div>

            <div class="form-group">
                <label for="Name">Subject Name:</label>
                <input type="text" id="Name" name="Name" value="<%= subject.Name %>" required>
                <span class="hint">Enter a clear and descriptive subject name</span>
            </div>

            <div class="form-group">
                <label for="Description">Description:</label>
                <textarea id="Description" name="Description" rows="4"><%= subject.Description || '' %></textarea>
                <span class="hint">Optional: Provide a brief description of the subject</span>
            </div>

            <% if (subject.DateCreated) { %>
                <div class="form-group">
                    <label>Date Created:</label>
                    <p><%= new Date(subject.DateCreated).toLocaleString() %></p>
                </div>
            <% } %>

            <div class="form-buttons">
                <button type="submit">Update Subject</button>
                <a href="/subjects" class="cancel-button">Cancel</a>
            </div>
        </form>
    </div>

    <script>
        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const name = document.getElementById('Name').value.trim();
            
            if (!name) {
                e.preventDefault();
                alert('Please enter a subject name');
                return false;
            }
            
            if (name.length < 2) {
                e.preventDefault();
                alert('Subject name must be at least 2 characters long');
                return false;
            }
        });
    </script>
</body>
<%- include('../partials/footer.ejs') %>
</html>