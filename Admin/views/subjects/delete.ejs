<!DOCTYPE html>
<html xmlns="https://xineartsolutions.com">
<%- include('../partials/header.ejs') %>
<body>
    <%- include('../partials/nav.ejs') %>
    
    <div class="detail-ui content">
        <h2><%= title %></h2>
        
        <div class="delete-warning">
            <div class="warning-icon">⚠️</div>
            <h3>Are you sure you want to delete this subject?</h3>
            <p>This action cannot be undone.</p>
        </div>

        <div class="detail-section">
            <div class="detail-row">
                <span class="detail-label">ID:</span>
                <span class="detail-value"><%= subject.Id %></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Name:</span>
                <span class="detail-value"><strong><%= subject.Name %></strong></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Description:</span>
                <span class="detail-value"><%= subject.Description || 'N/A' %></span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Date Created:</span>
                <span class="detail-value"><%= subject.DateCreated ? new Date(subject.DateCreated).toLocaleString() : 'N/A' %></span>
            </div>
        </div>

        <div class="form-buttons">
            <form action="/subjects/delete/<%= subject.Id %>" method="POST" style="display: inline-block;">
                <button type="submit" class="btn btn-danger">Yes, Delete Subject</button>
            </form>
            <a href="/subjects" class="cancel-button">Cancel</a>
        </div>
    </div>

</body>
<%- include('../partials/footer.ejs') %>
</html>