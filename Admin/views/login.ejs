<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>
    <link rel="stylesheet" href="/admin/styles.css">
</head>
<body>
    <div class="info-message">
       <h1 style="color: purple; font-size: 50px;">ADMIN LOGIN</h1>
    </div>

    <div class="login-container">
        <h2>Admin Login</h2>

        <% if (error) { %>
            <div class="error-message"><%= error %></div>
        <% } %>

        <% if (message) { %>
            <div class="info-message"><%= message %></div>
        <% } %>

        <!-- FIXED: Added /admin to the form action -->
        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label for="UserName">Username:</label>
                <input type="text" id="UserName" name="UserName" required />
            </div>

            <div class="form-group">
                <label for="Password">Password:</label>
                <input type="password" id="Password" name="Password" required />
            </div>

            <div class="form-buttons">
                <button type="submit">Login</button>
            </div>

            <div class="form-buttons">
                <!-- FIXED: Added /admin to the link -->
                <p>Forgot Password? <a href="/admin/resetpassword">Change</a></p>
            </div>
        </form>
    </div>

    <div class="form-buttons">
        <!-- FIXED: Added /admin to the link -->
        <p>No account? <a href="/admin/register">Register here</a></p>
    </div>
</body>
</html>